{
  "manifest_version": 3,
  "name": "Canvas Quiz AI Solver",
  "version": "1.1.2",
  "description": "Smart scraper and AI examination assistant for Canvas Quizzes (Classic & New Quizzes/Learnosity) with OpenRouter integration.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.instructure.com/*",
        "*://*.learnosity.com/*",
        "*://*.inscloudgate.net/*",
        "*://*.canvaslms.com/*"
      ],
      "js": [
        "content/content.js"
      ],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_end"
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Canvas Quiz AI Solver",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
